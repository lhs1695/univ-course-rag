POSTGRES_USER=univ
POSTGRES_PASSWORD=univ
POSTGRES_DB=univ_course_rag
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://univ:univ@localhost:5432/univ_course_rag

# 登录是 HTTP-only Cookie + 服务端 sessions 表。下面占位当前后端未读取。
SESSION_SECRET=change-me-in-local-env

# 提问原文默认留存 90 天；管理员维护每次最多检查/删除 100 条最旧到期记录。
# 合法范围分别为 1–3650 天、1–1000 条。清理只作用于当前数据库，不会抹除外部备份。
QUERY_LOG_RETENTION_DAYS=90
QUERY_LOG_CLEANUP_BATCH_SIZE=100

# 演示账号用户名见 AGENTS.md；密码只放本机 .env，此处为占位。
SEED_ADMIN_PASSWORD=change-me-admin
SEED_TEACHER_PASSWORD=change-me-teacher
SEED_STUDENT_PASSWORD=change-me-student

# pytest 的测试夹具仍使用 FakeEmbedder/FakeLLM，因此无云 key 也能稳定测试。
# 答辩/试用演示只在本机 .env 设 EMBEDDER_BACKEND=siliconflow、LLM_BACKEND=deepseek，并自行填写两个 key（不要提交或贴进聊天）。
# 改完 .env 后重启 uvicorn，运行中的后端才会读取新配置。
EMBEDDER_BACKEND=fake
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_API_KEY=
EMBEDDING_BATCH_SIZE=32
# pending/running 超过此时间后，教师可通过重试入口恢复；每个嵌入批次会刷新心跳。
INGEST_STALE_SECONDS=900
# 成功抽取但少于此字符数时只显示质量提示，不将资料判为失败。
INGEST_LOW_TEXT_CHARS=200

LLM_BACKEND=fake
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
