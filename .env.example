POSTGRES_USER=univ
POSTGRES_PASSWORD=univ
POSTGRES_DB=univ_course_rag_cn_v2
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://univ:univ@localhost:5432/univ_course_rag_cn_v2

# Midterm demo course PDFs (absolute paths recorded in DB for this machine).
# Relative path from repo root; required for opening cited PDFs on this checkout.
UPLOAD_DIR=corpus/local/cn-replace-2026-10-18/rechunk/uploads_v2

# 登录使用 HTTP-only Cookie + 服务端 Session；本机 HTTP 不启用 Secure Cookie。
SESSION_COOKIE_NAME=session_id
SESSION_TTL_SECONDS=604800
SESSION_COOKIE_SECURE=false
SESSION_CLEANUP_BATCH_SIZE=100

# 提问原文默认留存 90 天；管理员维护每次最多检查/删除 100 条最旧到期记录。
# 合法范围分别为 1–3650 天、1–1000 条。清理只作用于当前数据库，不会抹除外部备份。
QUERY_LOG_RETENTION_DAYS=90
QUERY_LOG_CLEANUP_BATCH_SIZE=100

# 演示账号用户名见 AGENTS.md；密码只放本机 .env，此处为占位。
SEED_ADMIN_PASSWORD=change-me-admin
SEED_TEACHER_PASSWORD=change-me-teacher
SEED_STUDENT_PASSWORD=change-me-student

# ---------------------------------------------------------------------------
# API Keys（只写本机 .env，禁止提交 / 贴进聊天 / 截图）
# 结题推荐最多三把；默认 Fake，无 key 也能跑测试与本地演示骨架。
#
# Key A  SILICONFLOW_API_KEY     硅基流动 —— Embedding（必填才能真实入库/检索向量）
#                                可选重排 / 问句分组也复用这一把（见 RERANKER_*）
# Key B  DEEPSEEK_API_KEY        DeepSeek 官方 —— 学生问答生成（LLM_BACKEND=deepseek）
# Key C  AGENT_DEEPSEEK_API_KEY  DeepSeek 官方 —— 教师 Agent（课内问题调查）专用
#                                可与 Key B 相同账号下的另一把，便于账单隔离；
#                                若留空，Agent 实现落地后回落到 DEEPSEEK_API_KEY。
#
# 最小可跑真实链路：只填 A+B，C 留空即可（Agent 与问答共用 B）。
# 改完 .env 后重启 uvicorn 才会生效。pytest 始终用 FakeEmbedder/FakeLLM。
# ---------------------------------------------------------------------------
EMBEDDER_BACKEND=fake
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_API_KEY=
EMBEDDING_BATCH_SIZE=32
# pending/running 超过此时间后，教师可通过重试入口恢复；每个嵌入批次会刷新心跳。
INGEST_STALE_SECONDS=900
# 成功抽取但少于此字符数时只显示质量提示，不将资料判为失败。
INGEST_LOW_TEXT_CHARS=200

# 检索策略 dense（默认，保持原向量门槛与排序）或 hybrid（向量 + 关键词后做 RRF）。
# hybrid 先合并完整有界候选，再执行保守余弦门槛；BM25/RRF/重排分都不授权回答。
RETRIEVAL_STRATEGY=dense
# Reciprocal Rank Fusion 的排名常数 k，只影响 hybrid 排序，不是相似度门槛。
RRF_K=60

# 可选重排只用于显式 hybrid；disabled 不创建客户端、不调用服务。
# siliconflow 沿用 SILICONFLOW_API_KEY；实际模型调用仍需当次联网/计费授权。
# 当前只改变候选顺序，关键词独有片段仍须后续充分性验证，不能凭高分放行。
RERANKER_BACKEND=disabled
# Explicit POST-only question grouping; embedding reuses configured SiliconFlow.
# No default semantic cutoff: each request supplies min_similarity for review.
QUESTION_GROUPING_BACKEND=disabled
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_BASE_URL=https://api.siliconflow.cn/v1

# 学生问答生成：默认 fake；真实演示设 LLM_BACKEND=deepseek 并填 DEEPSEEK_API_KEY。
# 模型与基址指向 DeepSeek 官方（不是硅基流动上的同名模型）。
LLM_BACKEND=fake
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=

# 教师 Agent（课内问题调查）：默认与学生问答共用 DEEPSEEK_*。
# 若要单独计费/轮换，另建一把 DeepSeek 官方 Key 填到下面；留空则回落 DEEPSEEK_API_KEY。
# Agent 运行时落地前此变量可先占位，不影响现有问答。
AGENT_DEEPSEEK_API_KEY=
# 可选覆盖；留空则沿用 DEEPSEEK_MODEL / DEEPSEEK_BASE_URL。
AGENT_DEEPSEEK_MODEL=
AGENT_DEEPSEEK_BASE_URL=

# 真实后端缺 key/模型名/合法地址会明确不可用，不回退 Fake。
# 此超时为单次上游请求超时，SDK 最多重试下列次数；浏览器超时不承诺停止上游计费。
# 重排复用上述超时时间作为 HTTPX IO 阶段超时，单请求不自动重试；MAX_RETRIES 仅作用于 embedding/LLM SDK。
UPSTREAM_TIMEOUT_SECONDS=20
UPSTREAM_MAX_RETRIES=2
